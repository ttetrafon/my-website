  <ExperienceSection
    company="Freelancing"
    title="Solutions Architect & Full Stack Engineer"
    location="Remote (EU & USA)"
    started="2017"
  >
    <ul class="xp-list">
      <li>...</li>
    </ul>
    <ExperienceProjects />
  </ExperienceSection>
  <ExperienceSection
    company="ITSAUR"
    title="Backend Engineer"
    location="Greece, Thessaloniki"
    started="October 2024"
    finished="October 2025"
  >
    <ul class="xp-list">
      <li>
        Development & DevOps of an airport warehouse management and automation
        system as part of an inter-company team (Docker swarm, Jenkins, Java).
      </li>
    </ul>
    <ExperienceProjects />
  </ExperienceSection>
  <ExperienceSection
    company="Polar Moment"
    title="Cloud Engineer & Full Stack Developer"
    location="Remote (UK)"
    started="September 2019"
    finished="July 2024"
  >
    <ul class="xp-list">
      <li>...</li>
    </ul>
    <ExperienceProjects />
  </ExperienceSection>
  <ExperienceSection
    company="Bio-Morphis"
    title="Junior Full Stack Developer"
    location="Remote (UK)"
    started="December 2018"
    finished="September 2019"
