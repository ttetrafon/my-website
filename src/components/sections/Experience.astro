---
import ArticleTitle from "../generic/ArticleTitle.astro";
import ExperienceProjects from "../generic/ExperienceProjects.astro";
import ExperienceSection from "../generic/ExperienceSection.astro";
import TechStackItem from "../generic/TechStackItem.astro";
---

<!-- TODO: make the customers/employees and technologies inline elements with their icon and highlighted text! -->
<article id="experience">
  <ArticleTitle title="Experience" icon="work_history" />

  <ExperienceSection
    company="Freelancing"
    title="Solutions Architect & Full Stack Engineer"
    location="Remote (EU & USA)"
    started="2017"
  >
    <ul class="xp-list">
      <li>
        Designed and built <b>custom applications</b> as solutions for various customer
        needs, from e-shop support systems, to internal management tools, and to data
        scrapping and analysis tools.
      </li>
      <li>
        Built a custom, light-weight <b>CMS system</b> to be used in websites with
        minimal needs, like online restaurant menus and information websites. Full
        system designed as a serverless application on <TechStackItem
          key="AWS"
          inline={true}
        />
        /<TechStackItem key="CloudFlare" inline={true} />.
      </li>
      <li>
        Built company and personal <b>websites</b> either from the ground up or rebuilt/renewed
        existing ones.
      </li>
      <li>
        Worked in supporting/bug fixing existing <b>AI</b> powered tools and companion
        apps, as well built a niche AI companion that automated buying and selling
        <b>NFTs</b>.
      </li>
    </ul>
    <ExperienceProjects
      prj={[
        "centralisedFormHandlingApi",
        "takozidis",
        "soda",
        "chaletRompolo",
        "menuEditor",
        "pricesScrapper",
        "myPortfolio",
      ]}
    />
  </ExperienceSection>

  <ExperienceSection
    company="ITSAUR"
    title="Backend Engineer"
    location="Greece, Thessaloniki"
    started="October 2024"
    finished="October 2025"
  >
    <ul class="xp-list">
      <li>
        Worked on development, extension, and improvement of an airport
        warehouse management automation system, operating as an organisation &
        automation tool for warehouse worker and provided connectivity with
        external system (global airport management & logistic companies).
      </li>
      <li>
        Was part of two small teams simultaneously, backend development (3
        persons total) and dev-ops (2 persons total).
      </li>
      <li>
        Backend processing and automation in <TechStackItem
          key="Java"
          inline={true}
        /> (<TechStackItem
          key="JavaSpring"
          altTitle="Spring Boot"
          inline={true}
        />)
        <b>microservices</b> orchestrated through <TechStackItem
          key="Java"
          inline={true}
          altTitle="Docker Swarm"
        />, communicating with <TechStackItem
          key="ApacheKafka"
          altTitle="Kafka"
          inline={true}
        /> and/or <b>web requests</b> as needed.
      </li>
      <li>
        DevOps in <TechStackItem key="Bash" inline={true} />, <TechStackItem
          key="Java"
          inline={true}
        />, and <TechStackItem key="Jenkins" inline={true} />, system deployed
        in dedicated, local server (<TechStackItem
          key="ApacheTomcat"
          altTitle="Tomcat"
          inline={true}
        />) in each warehouse.
      </li>
    </ul>
  </ExperienceSection>

  <ExperienceSection
    company="Polar Moment"
    title="Cloud Engineer & Full Stack Developer"
    location="Remote (UK & GR)"
    started="September 2019"
    finished="September 2024"
  >
    <ul class="xp-list">
      <li>
        Worked on various projects, initially as a member of the team, later as
        a team leader and solutions architect.
      </li>
      <li>
        An employee between September 2019 and September 2023, and then a
        contractor/consultant till September 2024.
      </li>
    </ul>
    <ExperienceProjects
      prj={[
        "pivotal",
        "dekoLink",
        "vendingMachineConnector",
        "instavoltPos",
        "bbcStreamingMonitoring",
      ]}
    />
  </ExperienceSection>

  <ExperienceSection
    company="Bio-Morphis"
    title="Junior Full Stack Developer"
    location="Remote (UK)"
    started="December 2018"
    finished="September 2019"
  >
    <ul class="xp-list">
      <li>
        Co-developed and deployed a <TechStackItem
          key="ApacheTomcat"
          altTitle="Tomcat"
          inline={true}
        /> server backend (<TechStackItem key="Java" inline={true} />).
      </li>
      <li>
        Participated in Designing and deploying the relevant frontend (<TechStackItem
          key="JavaScript"
          altTitle="JS"
          inline={true}
        />, <TechStackItem key="HTML5" inline={true} />, <TechStackItem
          key="CSS3"
          inline={true}
        />, <b>Ajax</b>, <b>WebSockets</b>).
      </li>
      <li>Thought out and implemented the UX and parts of the UI.</li>
      <li>
        Helped in developing a real-time system monitoring tool (<TechStackItem
          key="Cpp"
          inline={true}
        />).
      </li>
    </ul>
  </ExperienceSection>

  <ExperienceSection
    company="Freelancing"
    title="Scientific Paper Editor/Writer"
    location="Remote (GR)"
    started="2012"
    finished="2019"
  >
    <ul class="xp-list">
      <li>
        Guided others during writing <b>scientific papers</b> and <b>thesis</b>.
      </li>
      <li>Proofread scientific papers and thesis.</li>
    </ul>
  </ExperienceSection>
</article>
