export const clients = {
  // clients to showcase...
  latitudeClient,
  polarMomentClient,
  gamePaymentTechClient,
  pivotalClient,
  planetClient,
  paxClient,
  instavoltClient,
  dekoClient,
  itsaurClient,
  lodigeClient,
  treasureClient,
  takozidisClient,
  // placeholders just for the reference...
  rompoloClient,
  sodaClient,
};
export const clientList: Client[] = Object.values(clients);
export type ClientsKey = keyof typeof clients;
---

<article id="clients">
  <ArticleTitle title="Employers & Clients" icon="loyalty" />
  <section class="w-full flex flex-row flex-wrap justify-center gap-2">
    {
      clientList
        .filter((c) => c.display)
        .map((c) => (
          <ClientTile name={c.name} website={c.website} logo={c.logo} />
        ))
    }
  </section>
</article>
