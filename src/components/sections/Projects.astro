---
import ArticleTitle from "../generic/ArticleTitle.astro";
import ProjectTile from "../generic/ProjectTile.astro";
import type { TechStackKey } from "./TechStack.astro";

export interface Project {
  title: string;
  logo?: string;
  date: string;
  description: {
    explanation?: string;
    link?: {
      url: string;
      text: string;
    };
  }[];
  techDescription?: string[];
  techStack: TechStackKey[];
  isWide?: boolean;
}

export const soda: Project = {
  title: "Sport Bet Arbitration System [POC]",
  date: "March - July 2024",
  description: [
    {
      explanation:
        "A continuously running system, scrapping and retrieving betting info from various websites, comparing them, and calculating optimum betting strategies to maximise winnings while minimising loses.",
    },
  ],
  techDescription: [
    "Microservices architecture with docker images on k8s cluster (AWS EKS).",
    "Scripting done in Python.",
    "Communication and requests handled through async requests module.",
    "APIs implemented on top of FastApi with Uvicorn.",
  ],
  techStack: ["AWS", "Python", "JavaScript", "HTML5", "CSS3", "WebComponents"],
  isWide: true,
};
export const takozidis: Project = {
  title: "Takozidis.gr",
  logo: "takozidis",
  date: "March 2026",
  description: [
    {
      explanation: "Reworked site from WorldPress to ReactRouter.",
      link: {
        url: "https://www.takozids.gr",
        text: "Website (live)",
      },
    },
    {
      explanation: "Added e-shop and CMS functionality.",
      link: {
        url: "https://takozidis-website-staging.ttetrafon.workers.dev/",
        text: "e-shop (staging)",
      },
    },
  ],
  techDescription: [
    "Deployed in Cloudflare's workers, with data in D1 (sqlite) and R2 (data bucket).",
  ],
  techStack: ["CloudFlare", "Astro", "ReactRouter", "SQLite", "TypeScript"],
};

export const projects = { soda, takozidis };

export type ProjectsKey = keyof typeof projects;

// Order (and filter) the projects manually...
export const ps: ProjectsKey[] = ["takozidis", "soda"];
---

<article id="projects">
  <ArticleTitle title="Projects & Achievements" icon="assignment_turned_in" />
  <section class="w-full flex flex-row flex-wrap justify-center gap-2">
    {ps.map((p) => <ProjectTile project={p} />)}
  </section>
</article>
