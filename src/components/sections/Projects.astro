---
import ArticleTitle from "../generic/ArticleTitle.astro";
import ProjectTile from "../generic/ProjectTile.astro";
import type { TechStackKey } from "./TechStack.astro";

export interface Project {
  title: string;
  logo: string;
  date: string;
  description: {
    explanation?: string;
    link?: {
      url: string;
      text: string;
    };
  }[];
  techStack: TechStackKey[];
}
export const projects = {
  takozidis: {
    title: "Takozidis.gr",
    logo: "takozidis",
    description: [
      {
        explanation: "Reworked site from WorldPress to ReactRouter.",
        link: {
          url: "https://www.takozids.gr",
          text: "Website (live)",
        },
      },
      {
        explanation: "Added e-shop and CMS functionality.",
        link: {
          url: "https://takozidis-website-staging.ttetrafon.workers.dev/",
          text: "e-shop (staging)",
        },
      },
    ],
    date: "March 2026",
    techStack: ["CloudFlare", "Astro", "ReactRouter", "SQLite", "TypeScript"],
  },
};

export type ProjectsKey = keyof typeof projects;

// Order (and filter) the projects manually...
export const ps: ProjectsKey[] = ["takozidis"];
---

<article id="projects">
  <ArticleTitle title="Projects & Achievements" icon="assignment_turned_in" />
  <section class="w-full flex flex-row flex-wrap justify-center gap-2">
    {ps.map((p) => <ProjectTile project={p} />)}
  </section>
</article>
