---
import ArticleTitle from "../generic/ArticleTitle.astro";
import ProjectTile from "../generic/ProjectTile.astro";
import ProjectTileLink from "../generic/ProjectTileLink.astro";
import TechStackItem from "../generic/TechStackItem.astro";
import { bbcClient, dekoClient, type ClientsKey } from "./Clients.astro";

export interface Project {
  title: string;
  logo?: string;
  date: string;
  clients: ClientsKey[];
}

export const bbcStreamingMonitoring: Project = {
  title: "BBC Live Streaming Monitoring",
  logo: "bbc",
  date: "2022",
  clients: ["polarMomentClient", "bbcClient"],
};
export const chaletRompolo: Project = {
  title: "Chalet Rompolo",
  logo: "rompolo",
  date: "December 2023",
  clients: ["rompoloClient"],
};
export const dekoLink: Project = {
  title: "DEKO Payment Link",
  date: "2022",
  clients: ["polarMomentClient", "dekoClient"],
};
export const instavoltPos: Project = {
  title: "Electric Vehicle Charging Station POS",
  date: "2023 - 2024",
  clients: [
    "polarMomentClient",
    "instavoltClient",
    "paxClient",
    "mifareClient",
    "planetClient",
  ],
};
export const menuEditor: Project = {
  title: "Online Menu & Editor",
  date: "December 2023",
  clients: ["rompoloClient"],
};
export const myPortfolio: Project = {
  title: "This Website",
  logo: "ttetrafon",
  date: "April 2026",
  clients: [],
};
export const pivotal: Project = {
  title: "Pivotal Infrastructure",
  date: "2021 - 2023",
  clients: ["polarMomentClient", "pivotalClient"],
};
export const pricesScrapper: Project = {
  title: "Online Prices Scrapper",
  date: "October 2025",
  clients: [],
};
export const soda: Project = {
  title: "Sport Bet Arbitration System [POC]",
  date: "March - July 2024",
  clients: ["sodaClient"],
};
export const takozidis: Project = {
  title: "Takozidis.gr",
  logo: "takozidis",
  date: "March 2026",
  clients: ["takozidisClient"],
};
export const vendingMachineConnector: Project = {
  title: "Vending Machine - POS Link",
  date: "2023",
  clients: ["polarMomentClient", "paxClient", "planetClient"],
};

export const projects = {
  bbcStreamingMonitoring,
  chaletRompolo,
  dekoLink,
  instavoltPos,
  menuEditor,
  myPortfolio,
  pivotal,
  pricesScrapper,
  soda,
  takozidis,
  vendingMachineConnector,
};

export type ProjectsKey = keyof typeof projects;
---

<article id="projects">
  <ArticleTitle title="Projects & Achievements" icon="assignment_turned_in" />
  <section
    class="projects-container w-full flex flex-row flex-wrap justify-center items-stretch gap-2"
  >
    <!-- SOLUTIONS -->

    <ProjectTile project="pivotal">
      <ul class="project-list">
        <li>
          <span>
            Lead the move from <b>Pivotal's</b> local infrastructure, Microsoft Excel
            spreadsheets edited manually, payments placed by personnel, and invoicing
            done in Microsoft Word, to a fully automated system.
          </span>
        </li>
        <li>
          <span
            >Personally communicated with the client with the purpose of
            designing and proposing a <b>technical solution</b>.</span
          >
        </li>
        <li>
          <span
            >The automated system handled everything between drivers' input, to
            payments at the end of day, to invoicing at the end of month.</span
          >
        </li>
        <li>
          Besides the processing infrastructure, designed and developed a
          front-end system to be used by all personnel, including drivers,
          accountants, and admins.
        </li>
        <li>
          Incorporated into all levels of the system <b
            >fraud prevention/detection</b
          >
          as required by UK legislation.
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          Designed for and deployed on <TechStackItem
            key="AWS"
            inline={true}
          />.
        </li>
        <li>
          Processing done in <TechStackItem
            key="AWS"
            altTitle="Lambda functions"
            inline={true}
          /> written in <TechStackItem key="Java" inline={true} />, using timed
          and user events as triggers, and <TechStackItem
            key="AWS"
            altTitle="SQS"
            inline={true}
          /> for communication between Lambdas.
        </li>
        <li>
          Data storage in <TechStackItem
            key="AWS"
            altTitle="Aurora (MySQL)"
            inline={true}
          /> and <TechStackItem key="AWS" altTitle="AWS S3" inline={true} />.
        </li>
        <li>
          UI in <TechStackItem key="Angular" inline={true} /> (with <TechStackItem
            key="TypeScript"
            inline={true}
          />).
        </li>
      </ul>
    </ProjectTile>

    <ProjectTile project="dekoLink">
      <ul class="project-list">
        <li>
          <span
            >Worked within Deko's change from monolithic <b>PHP</b> to <TechStackItem
              key="AWS"
              altTitle="AWS microservices"
              inline={true}
            />. Our team was responsible for designing and building a bridge
            between the merchant front-end and a specific payment provider, as a
            template for later work.</span
          >
        </li>
        <li>
          <span
            >Personally, worked on designing the solution, inter-team
            coordination, development, and finally terraform scripts.</span
          >
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          Deployed in <TechStackItem key="JavaSpring" inline={true} />.
        </li>
        <li>
          Deployed in <TechStackItem key="AWS" altTitle="EKS" inline={true} /> with
          <TechStackItem key="Terraform" inline={true} />.
        </li>
        <li>
          Internal microservices communication through <TechStackItem
            key="ApacheKafka"
            inline={true}
          />.
        </li>
        <li>
          External communication with payment providers through <b
            >https requests</b
          > on their respective <b>API</b>.
        </li>
      </ul>
    </ProjectTile>

    <ProjectTile project="bbcStreamingMonitoring">
      <ul class="project-list">
        <li>
          <span
            >A live streaming monitoring tool used to produce real-time alerts
            when streaming video and/or subtitles problems arise.</span
          >
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          Monitoring tool developed in <TechStackItem
            key="Cpp"
            inline={true}
          />. Reads streaming data through <b>RTP (over UDP)</b>, analyses them,
          and publishes events towards a designated app (over <b>HTTPS</b>).
        </li>
        <li>
          Alert publisher app written in <TechStackItem
            key="Python"
            inline={true}
          />. Receives events from the monitoring tool and publishes them in <TechStackItem
            key="AWS"
            altTitle="AWS SNS"
            inline={true}
          /> so the appropriate people are notified.
        </li>
        <li>
          Deployed in <TechStackItem
            key="AWS"
            altTitle="AWS EC2"
            inline={true}
          />.
        </li>
        <li>
          Operational monitoring done through <TechStackItem
            key="AWS"
            altTitle="AWS CloudWatch"
            inline={true}
          /> and automated instance handling through <TechStackItem
            key="AWS"
            altTitle="AWS Lambda"
            inline={true}
          />.
        </li>
      </ul>
    </ProjectTile>

    <ProjectTile project="takozidis">
      <ul class="project-list">
        <li>
          <span>Reworked site from WorldPress to ReactRouter.</span>
          <ProjectTileLink
            url="https://www.takozidis.gr/"
            title="Website (live)"
          />
        </li>
        <li>
          <span>Added e-shop and CMS functionality.</span>
          <ProjectTileLink
            url="https://takozidis-website-staging.ttetrafon.workers.dev/"
            title="e-shop (staging)"
          />
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          UI built on <TechStackItem key="React" inline={true} /> with <TechStackItem
            key="Tailwind"
            inline={true}
          />.
        </li>
        <li>
          Used <TechStackItem key="ReactRouter" inline={true} /> for a combined
          <b>SPA</b> and <b>SSR</b> result.
        </li>
        <li>
          CMS designed and developed from the ground up in <TechStackItem
            key="TypeScript"
            inline={true}
          />, using a combination of <b>API calls</b> and <b>SSR</b> as needed.
        </li>
        <li>
          Deployed on <TechStackItem
            key="CloudFlare"
            altTitle="CloudFlare Workers"
            inline={true}
          />.
        </li>
        <li>
          Data stored within <TechStackItem
            key="CloudFlare"
            altTitle="CloudFlare's"
            inline={true}
          /> ecosystem, <TechStackItem
            key="SQLite"
            altTitle="D1 (SQLite)"
            inline={true}
          /> and <TechStackItem
            key="NoSQL"
            altTitle="R2 (data bucket)"
            inline={true}
          />.
        </li>
      </ul>
    </ProjectTile>

    <ProjectTile project="soda">
      <ul class="project-list">
        <li>
          <span
            >A continuously running system, scrapping and retrieving betting
            info from various websites, comparing them, and calculating optimum
            betting strategies to maximise winnings while minimising loses.</span
          >
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          <b>Microservices</b> architecture with <TechStackItem
            key="Docker"
            altTitle="docker images"
            inline={true}
          /> on <TechStackItem
            key="Kubernetes"
            altTitle="k8s cluster"
            inline={true}
          /> (<TechStackItem key="AWS" altTitle="AWS EKS" inline={true} />).
        </li>
        <li>
          Scripting and analysis done in <TechStackItem
            key="Python"
            inline={true}
          />.
          <li>
            Communication between services and requests handled through <b
              >async requests</b
            > module.
          </li>
          <li>
            APIs implemented on top of <TechStackItem
              key="Fastapi"
              inline={true}
            /> with <b>Uvicorn</b>.
          </li>
        </li>
        <li>
          User and management UI built on <TechStackItem
            key="HTML5"
            inline={true}
          />, <TechStackItem key="CSS3" inline={true} />, and <TechStackItem
            key="JavaScript"
            inline={true}
          /> with <TechStackItem key="WebComponents" inline={true} />, and
          deployed in <TechStackItem
            key="AWS"
            altTitle="AWS (ApiGateway, CloudFront, S3)"
            inline={true}
          />.
        </li>
      </ul>
    </ProjectTile>

    <!-- POS -->

    <ProjectTile project="instavoltPos">
      <ul class="project-list">
        <li>
          <span
            >Built an <TechStackItem
              key="Android"
              altTitle="android app"
              inline={true}
            /> to be used on the <b>PAX Terminal</b> attached on EV charging stations.</span
          >
        </li>
        <li>
          <span
            >The app acts as the point of contact with the customer using a <b
              >MiFare</b
            > or
            <b>credit card</b> to start a charging session for their connected vehicle.</span
          >
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          App written in <TechStackItem key="Java" inline={true} /> for <TechStackItem
            key="Android"
            inline={true}
          />.
        </li>
        <li>
          <b>Credit card</b> processing handled through <b>Planet Payment</b> SDK
          and direct <b>https</b> communication with their servers.
        </li>
        <li>
          <b>MiFare card</b> processing handled in-app, with checks performed by communicating
          directly with MiFare backend services over <b>https</b>.
        </li>
      </ul>
    </ProjectTile>

    <ProjectTile project="vendingMachineConnector">
      <ul class="project-list">
        <li>
          <span
            >Built an <TechStackItem
              key="Android"
              altTitle="android app"
              inline={true}
            /> to be used on the <b>PAX Terminal</b> attached on vending machines.</span
          >
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          App written in <TechStackItem key="Java" inline={true} /> for <TechStackItem
            key="Android"
            inline={true}
          />.
        </li>
        <li>
          <b>Credit card</b> processing handled through <b>Planet Payment</b> SDK
          and direct <b>https</b> communication with their servers.
        </li>
        <li>
          Communication with the vending machine done over the <b>DEX/UCS</b> protocol.
        </li>
      </ul>
    </ProjectTile>

    <!-- MINOR -->

    <ProjectTile project="chaletRompolo">
      <ul class="project-list">
        <li>
          <span>Chalet Rompolo</span>
          <ProjectTileLink
            url="https://chalet-rompolo.com/"
            title="Website (live)"
          />
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          Built in <TechStackItem key="HTML5" inline={true} />, <TechStackItem
            key="CSS3"
            inline={true}
          />, and <TechStackItem key="JavaScript" inline={true} /> with <TechStackItem
            key="WebComponents"
            inline={true}
          />, and deployed in <TechStackItem
            key="AWS"
            altTitle="AWS (ApiGateway, CloudFront, S3)"
            inline={true}
          />
        </li>
      </ul>
    </ProjectTile>

    <ProjectTile project="menuEditor">
      <ul class="project-list">
        <li>
          <span>Minimal live menu & editor for restaurants.</span>
          <ProjectTileLink
            url="https://menu.chalet-rompolo.com/"
            title="Rompolo chalet menu"
          />
          <ProjectTileLink
            url="https://menu.vasilitsa1850.com/"
            title="Vasilitsa chalet menu"
          />
        </li>
      </ul>
      <ul class="xp-list">
        <li>
          User and management UI built in <TechStackItem
            key="HTML5"
            inline={true}
          />, <TechStackItem key="CSS3" inline={true} />, and <TechStackItem
            key="JavaScript"
            inline={true}
          /> with <TechStackItem key="WebComponents" inline={true} />, and
          deployed in <TechStackItem
            key="AWS"
            altTitle="AWS (ApiGateway, CloudFront, S3)"
            inline={true}
          />
        </li>
        <li>
          <b>CMS</b> system works with <b>API requests</b> on <TechStackItem
            key="AWS"
            altTitle="AWS Lambda"
            inline={true}
          />. Data stored in <TechStackItem
            key="AWS"
            altTitle="AWS S3"
            inline={true}
          />, alongside the website assets for immediate updates.
        </li>
      </ul>
    </ProjectTile>

    <ProjectTile project="pricesScrapper">
      <ul class="project-list">
        <li>
          <span
            >A web scrapper designed to collect prices of specific projects from
            specific websites and transmit them to clients for review.</span
          >
        </li>
      </ul>
      <ul class="xp-list">
        <li>Developed in <TechStackItem key="Python" inline={true} />.</li>
        <li>
          Deployed in a <b>VPS</b> where it runs on a schedule and transmits the scrapped
          data to designated clients.
        </li>
      </ul>
    </ProjectTile>

    <ProjectTile project="myPortfolio">
      <ul class="project-list">
        <li>
          <span>My online portfolio & CV.</span>
          <ProjectTileLink
            url="https://github.com/ttetrafon/my-website"
            title="GitHub repo"
          />
        </li>
      </ul>
      <ul class="xp-list">
        <li>Developed in <TechStackItem key="Astro" inline={true} />.</li>
        <li>
          Deployed in <TechStackItem
            key="CloudFlare"
            altTitle="CloudFlare pages"
            inline={true}
          />.
        </li>
      </ul>
    </ProjectTile>

    <!-- <ProjectTile project="myPortfolio">
      <ul class="project-list">
        <li>
          <span>...</span>
          <ProjectTileLink
            url="https://github.com/ttetrafon/my-website"
            title="GitHub repo"
          />
        </li>
      </ul>
      <ul class="xp-list">
        <li>...</li>
      </ul>
    </ProjectTile> -->
  </section>
</article>
