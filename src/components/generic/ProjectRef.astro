---
import {
  projects,
  type Project,
  type ProjectsKey,
} from "../sections/Projects.astro";
import Logo from "./Logo.astro";

interface Props {
  prj: ProjectsKey;
}
const { prj } = Astro.props;

const p: Project = projects[prj as ProjectsKey] as Project;
---

<a
  href={`#${p.title}`}
  class="flex flex-row flex-nowrap items-center gap-1 mt-2 bg-background p-2 border border-typography rounded-md"
  aria-label={p.title}
>
  {p.logo && <Logo logo={p.logo} />}
  <span>{p.title}</span>
</a>
