---
import { clients, type Client } from "../sections/Clients.astro";
import {
  projects,
  type Project,
  type ProjectsKey,
} from "../sections/Projects.astro";
import ClientTile from "./ClientTile.astro";
import Logo from "./Logo.astro";

interface Props {
  project: string;
}
const { project } = Astro.props;

const p: Project = projects[project as ProjectsKey];
const relatedClients: Client[] = p.clients
  .map((c) => clients[c])
  .filter((c) => c.display);
---

<section
  id={p.title}
  class={`project-tile border border-typography bg-basis rounded-md px-2 py-1`}
>
  <div class="flex flex-row flex-nowrap items-start justify-between gap-3">
    <h2 class="flex flex-row flex-nowrap items-center gap-1 mt-2">
      {p.logo && <Logo logo={p.logo} />}
      <span>{p.title}</span>
    </h2>
    <span class="italic text-action text-right">{p.date}</span>
  </div>
  <!-- description & spec -->
  <slot />
  <!-- related clients/employees -->
  {
    relatedClients.length > 0 && (
      <>
        <h3 class="italic mt-4">Clients</h3>
        <div class="flex-1 flex flex-row flex-wrap gap-2 justify-center items-center p-2">
          {relatedClients.map((c) => (
            <ClientTile
              name={c.name}
              website={c.website}
              logo={c.logo}
              inside={true}
            />
          ))}
        </div>
      </>
    )
  }
</section>
