---
import { projects, type Project } from "../sections/Projects.astro";
import TechStackItem from "./TechStackItem.astro";

interface Props {
  project: string;
}
const { project } = Astro.props;

const p: Project = projects[project];
---

<section class="w-[32%] border border-typography bg-base rounded-md p-2">
  <h2>{p.title}</h2>
  <span>{p.date}</span>
  <!--  -->
  <div class="flex flex-row gap-2">
    {p.techStack.map((ti) => <TechStackItem key={ti} insert={true} />)}
  </div>
</section>
