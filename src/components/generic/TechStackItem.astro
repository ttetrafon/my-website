---
interface Props {
  title: string;
  icon?: string;
}
const { title, icon } = Astro.props;

const icons = import.meta.glob("../../assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const svgRaw = icon
  ? (icons[`../../assets/icons/${icon}.svg`] as string)
  : null;
const svgContent =
  svgRaw?.replace(/<svg/, `<svg class="rounded-md fill-action size-6"`) ?? "";
---

<p
  class="flex flex-row gap-2 items-center justify-center rounded-lg p-2 border border-typography bg-base"
>
  {svgContent && <Fragment set:html={svgContent} />}
  <span>{title}</span>
</p>
