---
import icon from "../../assets/icons/open_in_new.svg?raw";
import Logo from "./Logo.astro";

interface Props {
  name: string;
  website: string;
  logo?: string;
}
const { name, website, logo } = Astro.props;
---

<section class="border border-typography bg-base rounded-md p-2 cursor-pointer">
  <h4 class="flex flex-row flex-nowrap items-center gap-1">
    <Logo logo={logo} />
    <a class="text-action" href={website} target="_blank">
      {name}
    </a>
    <span class="inline-icon [&>svg]:size-4" set:html={icon} />
  </h4>
</section>
