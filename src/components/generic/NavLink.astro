---
interface Props {
  href: string;
  title: string;
  icon: string;
  target?: string;
  iconClass?: string;
  fill?: string;
}
const {
  href,
  title,
  icon,
  target = "_self",
  iconClass = "size-6",
  fill = "action",
} = Astro.props;

const fillClass: Record<string, string> = {
  action: "fill-action",
  base: "fill-basis",
  typography: "fill-typography",
  background: "fill-background",
};
const resolvedFill = fillClass[fill] ?? "fill-action";

const icons = import.meta.glob("../../assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const svgRaw = icon
  ? (icons[`../../assets/icons/${icon}.svg`] as string)
  : null;
const svgContent =
  svgRaw?.replace(
    /<svg/,
    `<svg class="rounded-md ${resolvedFill} ${iconClass}"`,
  ) ?? "";
---

<a href={href} title={title} class="p-1" aria-label={title} target={target}>
  {svgContent && <Fragment set:html={svgContent} />}
</a>
