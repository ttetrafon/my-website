---
const now = new Date();
const year = now.getFullYear();

const lastUpdated = "07/04/2026";
---

<footer class="flex flex-row flex-nowrap justify-between items-center">
  <span id="last-updated" class="italic whitespace-nowrap px-2"
    >Last Update: {lastUpdated}</span
  >
  <span class="px-2">Copyright © 2019-{year}</span>
</footer>
