---
import ArticleTitle from "./generic/ArticleTitle.astro";
import ClientTile from "./generic/ClientTile.astro";

interface client {
  name: string;
  website: string;
  logo: string;
}
export const clients: client[] = [
  {
    name: "Takozidis",
    website: "https://www.takozidis.gr/",
    logo: "takozidis",
  },
];
---

<article id="clients">
  <ArticleTitle title="Employers & Clients" icon="loyalty" />
  <section class="w-full flex flex-row flex-wrap justify-center gap-2">
    {
      clients.map((c) => (
        <ClientTile name={c.name} website={c.website} logo={c.logo} />
      ))
    }
  </section>
</article>
